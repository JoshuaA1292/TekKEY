# Build B: the gateway. Copy to .env and export, or set in the shell.
VENUE=fake                     # fake | real   (real = Build A's binaries in minsky/build and venued on 7010)
GATEWAY_DB=gateway/data/gateway.db
PORT=8080

# External services. Each is real when its key is set, otherwise a local stand-in that says so.
# GET /lab/status reports which are live.

# Capital One Nessie (simulated bank). Unset -> local bank simulator.
NESSIE_API_KEY=

# Chalk Model Gateway: every LLM call. Key from the Chalk dashboard or `chalk router api-key create`;
# the environment id is required on every request. Unset -> Anthropic direct if ANTHROPIC_API_KEY is
# set (dev only), else the rule-based stub. Older names CHALK_API_KEY / CHALK_AI_GATEWAY_URL still work.
CHALK_ROUTER_API_KEY=
CHALK_ENV_ID=
CHALK_ROUTER_URL=https://api.chalk.ai/v1/router
GATEWAY_MODEL=claude-opus-5-5  # any claude-*, openai/*, google/* id the router serves
LAB_MODELS=claude-opus-5-5
LAB_PROBE_LLM=0                # 1 -> /lab/status spends one token to prove the route answers

# Chalk datasets (chalk/federated.py): rows pushed through chalkpy when set, else written to evals/results/chalk/.
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENVIRONMENT=

# Photon 2.0 Spectrum: the owner's phone, through the Node sidecar in phone/ on the project's iMessage line.
# The sidecar needs both; the gateway needs the id (to route sends to the sidecar) and the sidecar URL.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHONE_SIDECAR_URL=http://127.0.0.1:8787
PHONE_SIDECAR_PORT=8787
PHOTON_OWNER_NUMBER=           # E.164; the default owner number when an account has none

# Daytona sandboxes for the delegate. Unset -> local subprocess (no egress control).
DAYTONA_API_KEY=

# Factory Droid: the repair loop. The Python SDK (droid-sdk) drives the local `droid` executable with
# FACTORY_API_KEY; without the key, `droid exec` on PATH; without the binary, the LLM, then the stub.
FACTORY_API_KEY=
DROID_BIN=droid
DROID_MODEL=                   # empty: Factory's default; e.g. claude-opus-5-5 or "auto" for the Factory Router
DROID_REASONING_EFFORT=
DROID_TIMEOUT_S=180

FAKE_STEP_MS=600               # fake venue: ms between played-back events (0 = instant)
